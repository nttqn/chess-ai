package com.trungchess.chess_app

import android.os.Bundle
import androidx.core.view.WindowCompat
import io.flutter.embedding.android.FlutterActivity

// Android 15 (targetSdk 35+) draws edge-to-edge by default; without this,
// Play Console's pre-launch report flags "some users may not see
// edge-to-edge". Flutter's own SafeArea widgets already pad content for
// system bars once the native window stops fitting them itself.
class MainActivity : FlutterActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        WindowCompat.setDecorFitsSystemWindows(window, false)
    }
}
